# Create a bot with @BotFather, then paste its token here locally.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID (comma-separated for more than one owner).
# With this blank, ONLY /whoami is available. No jobs are accepted.
ALLOWED_USER_IDS=

# Choose chatgpt_browser (no API key), openai, xai, gemini, or heuristic (offline basic ranking).
# Also switch from Telegram: /provider chatgpt, /provider grok or /provider gemini
AI_PROVIDER=chatgpt_browser
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional OpenAI-compatible Responses endpoint (leave blank for OpenAI).
OPENAI_BASE_URL=

# xAI Grok (uses only this key, never the OpenAI key)
XAI_API_KEY=
XAI_MODEL=grok-4.6

# Google Gemini (Google AI Studio API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ChatGPT website automation: run scripts/setup-browser.ps1 then scripts/chatgpt-login.ps1.
# Uses your website session/model and its limits. No API requests or paid fallback.
CHATGPT_BROWSER_TIMEOUT=240
CHATGPT_BROWSER_MAX_CHARS=60000
CHATGPT_BROWSER_HEADLESS=false

# Feature 1 music library, mixed at 20% gain under speech.
MUSIC_DIR=music

# Official Instagram publishing. Tokens stay in .env; account IDs/owner access in config/instagram.json.
INSTAGRAM_ACCOUNTS_FILE=config/instagram.json
INSTAGRAM_GRAPH_VERSION=v23.0
IG_CLIPS_TOKEN=
IG_DARK_TOKEN=
IG_MEN_TOKEN=
IG_MONEY_TOKEN=
IG_TECH_TOKEN=
IG_FINANCE_TOKEN=
# Map this HTTPS URL to PUBLIC_MEDIA_DIR through your existing hosting/reverse proxy.
PUBLIC_MEDIA_BASE_URL=
PUBLIC_MEDIA_DIR=data/public-media

# One original character reference and Instagram destination per niche.
NICHES_CONFIG_FILE=config/niches.json

WHISPER_MODEL=small
WHISPER_BEAM_SIZE=5
# RTX 4060 8GB profile. Install GPU dependencies: pip install -e '.[gpu]'
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8_float16
GPU_DEVICE_INDEX=0
VIDEO_ENCODER=h264_nvenc
# CPU-only machines: WHISPER_DEVICE=cpu, WHISPER_COMPUTE_TYPE=int8, VIDEO_ENCODER=libx264
DATA_DIR=./data
# Blank uses system FFmpeg, then the imageio-ffmpeg bundled binary.
FFMPEG_PATH=
MAX_SOURCE_MINUTES=120
MAX_DOWNLOAD_MB=1500
MIN_FREE_DISK_MB=3000
MAX_ACTIVE_JOBS=3
RETENTION_DAYS=7
# Hosting provider allowlist; direct files can be supplied via Telegram or CLI.
ALLOWED_VIDEO_HOSTS=youtube.com,youtu.be,vimeo.com,twitch.tv

# Gemini carousel QA is enabled. Skipping it forces manual publication review.
CLIPER_SKIP_IMAGE_QA=false
# Optional separate Gemini profile; leaving this commented reuses the existing saved browser profile.
# Sign in again with scripts/gemini-login.ps1 after choosing a different profile.
# GEMINI_BROWSER_PROFILE=data/browsers/gemini-profile
